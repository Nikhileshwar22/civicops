// ============================================================
// CivicOps - Prisma Schema
// Multi-Tenant Civic Operations & Complaint Management Platform
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ============================================================
// TENANT
// ============================================================

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  domain    String?
  logoUrl   String?
  isActive  Boolean  @default(true)
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users         User[]
  roles         Role[]
  permissions   Permission[]
  departments   Department[]
  zones         Zone[]
  circles       Circle[]
  wards         Ward[]
  complaints    Complaint[]
  webhooks      Webhook[]
  notifications Notification[]
  auditLogs     AuditLog[]
  documents     Document[]
  aiAnalyses    AiAnalysis[]

  @@map("tenants")
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id              String   @id @default(uuid())
  email           String
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  avatarUrl       String?
  isActive        Boolean  @default(true)
  isEmailVerified Boolean  @default(false)
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  userRoles        UserRole[]
  userScopes       UserScope[]
  sessions         Session[]
  refreshTokens    RefreshToken[]
  complaintsOwned  Complaint[]         @relation("CitizenComplaints")
  assignedAsOfficer Complaint[]        @relation("OfficerAssignments")
  assignedAsWorker  Complaint[]        @relation("WorkerAssignments")
  comments         ComplaintComment[]
  attachmentsUploaded ComplaintAttachment[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  assignmentsMade  ComplaintAssignment[] @relation("AssignedBy")
  assignmentsReceived ComplaintAssignment[] @relation("AssignedTo")
  statusChanges    ComplaintStatusHistory[]

  @@unique([email, tenantId])
  @@index([tenantId])
  @@index([email])
  @@index([tenantId, isActive])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  ipAddress String?
  userAgent String?
  isActive  Boolean  @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================================
// RBAC (Role-Based Access Control)
// ============================================================

model Role {
  id          String   @id @default(uuid())
  name        String
  displayName String
  description String?
  level       Int      @default(0)
  tenantId    String
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([name, tenantId])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  name        String
  displayName String
  description String?
  resource    String
  action      String
  tenantId    String

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  rolePermissions RolePermission[]

  @@unique([name, tenantId])
  @@index([tenantId])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model UserScope {
  id           String  @id @default(uuid())
  userId       String
  scopeType    String  // GLOBAL, TENANT, ZONE, CIRCLE, WARD, ASSIGNED_ONLY
  zoneId       String?
  circleId     String?
  wardId       String?
  departmentId String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone       Zone?       @relation(fields: [zoneId], references: [id])
  circle     Circle?     @relation(fields: [circleId], references: [id])
  ward       Ward?       @relation(fields: [wardId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@index([userId])
  @@map("user_scopes")
}

// ============================================================
// GEOGRAPHY
// ============================================================

model Zone {
  id        String   @id @default(uuid())
  name      String
  code      String
  tenantId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  circles    Circle[]
  wards      Ward[]
  complaints Complaint[]
  userScopes UserScope[]

  @@unique([code, tenantId])
  @@index([tenantId])
  @@map("zones")
}

model Circle {
  id        String   @id @default(uuid())
  name      String
  code      String
  zoneId    String
  tenantId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone       Zone        @relation(fields: [zoneId], references: [id])
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  wards      Ward[]
  complaints Complaint[]
  userScopes UserScope[]

  @@unique([code, tenantId])
  @@index([tenantId])
  @@index([zoneId])
  @@map("circles")
}

model Ward {
  id        String   @id @default(uuid())
  name      String
  number    Int
  circleId  String
  zoneId    String
  tenantId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  circle     Circle      @relation(fields: [circleId], references: [id])
  zone       Zone        @relation(fields: [zoneId], references: [id])
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  complaints Complaint[]
  userScopes UserScope[]

  @@unique([number, tenantId])
  @@index([tenantId])
  @@index([circleId])
  @@index([zoneId])
  @@map("wards")
}

// ============================================================
// DEPARTMENTS
// ============================================================

model Department {
  id          String   @id @default(uuid())
  name        String
  code        String
  description String?
  tenantId    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  complaints Complaint[]
  userScopes UserScope[]

  @@unique([code, tenantId])
  @@index([tenantId])
  @@map("departments")
}

// ============================================================
// COMPLAINTS
// ============================================================

model Complaint {
  id               String   @id @default(uuid())
  complaintNumber  String   @unique
  title            String
  description      String
  category         String   // ComplaintCategory enum value
  subcategory      String?
  priority         String   @default("MEDIUM") // ComplaintPriority enum value
  status           String   @default("RECEIVED") // ComplaintStatus enum value
  latitude         Float?
  longitude        Float?
  address          String?
  tenantId         String
  zoneId           String?
  circleId         String?
  wardId           String?
  departmentId     String?
  citizenId        String
  assignedOfficerId String?
  assignedWorkerId  String?
  resolution       String?
  resolutionEvidence Json?
  slaDeadline      DateTime?
  slaBreached      Boolean  @default(false)
  slaWarningAt     DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  zone            Zone?       @relation(fields: [zoneId], references: [id])
  circle          Circle?     @relation(fields: [circleId], references: [id])
  ward            Ward?       @relation(fields: [wardId], references: [id])
  department      Department? @relation(fields: [departmentId], references: [id])
  citizen         User        @relation("CitizenComplaints", fields: [citizenId], references: [id])
  assignedOfficer User?       @relation("OfficerAssignments", fields: [assignedOfficerId], references: [id])
  assignedWorker  User?       @relation("WorkerAssignments", fields: [assignedWorkerId], references: [id])
  attachments     ComplaintAttachment[]
  comments        ComplaintComment[]
  statusHistory   ComplaintStatusHistory[]
  assignments     ComplaintAssignment[]
  aiClassification AiClassification?
  aiSummaries     AiSummary[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([tenantId, category])
  @@index([tenantId, departmentId])
  @@index([tenantId, zoneId])
  @@index([tenantId, circleId])
  @@index([tenantId, wardId])
  @@index([citizenId])
  @@index([assignedOfficerId])
  @@index([assignedWorkerId])
  @@index([createdAt])
  @@index([slaDeadline])
  @@index([slaBreached])
  @@index([complaintNumber])
  @@map("complaints")
}

model ComplaintAttachment {
  id          String   @id @default(uuid())
  complaintId String
  tenantId    String
  objectKey   String
  fileName    String
  mimeType    String
  fileSize    Int
  uploadedBy  String
  createdAt   DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  uploader  User      @relation(fields: [uploadedBy], references: [id])

  @@index([complaintId])
  @@index([tenantId])
  @@map("complaint_attachments")
}

model ComplaintComment {
  id          String   @id @default(uuid())
  complaintId String
  userId      String
  content     String
  isInternal  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([complaintId])
  @@index([complaintId, isInternal])
  @@map("complaint_comments")
}

model ComplaintStatusHistory {
  id          String   @id @default(uuid())
  complaintId String
  fromStatus  String
  toStatus    String
  changedBy   String
  notes       String?
  createdAt   DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [changedBy], references: [id])

  @@index([complaintId])
  @@index([createdAt])
  @@map("complaint_status_history")
}

model ComplaintAssignment {
  id           String   @id @default(uuid())
  complaintId  String
  assignedToId String
  assignedById String
  role         String   // OFFICER or WORKER
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  complaint  Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  assignedTo User      @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedBy User      @relation("AssignedBy", fields: [assignedById], references: [id])

  @@index([complaintId])
  @@index([assignedToId])
  @@map("complaint_assignments")
}

// ============================================================
// AI
// ============================================================

model AiClassification {
  id                  String   @id @default(uuid())
  complaintId         String   @unique
  category            String
  subcategory         String?
  priority            String
  suggestedDepartment String?
  suggestedSlaHours   Int?
  confidence          Float
  reasoning           String?
  modelUsed           String
  processingTimeMs    Int?
  createdAt           DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("ai_classifications")
}

model AiSummary {
  id               String   @id @default(uuid())
  complaintId      String
  summary          String
  keyPoints        Json?
  modelUsed        String
  processingTimeMs Int?
  createdAt        DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("ai_summaries")
}

model AiAnalysis {
  id               String   @id @default(uuid())
  tenantId         String
  analysisType     String   // IMAGE, TEXT, ANALYTICS
  inputData        Json
  result           Json
  modelUsed        String
  confidence       Float?
  processingTimeMs Int?
  createdAt        DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([analysisType])
  @@map("ai_analyses")
}

// ============================================================
// RAG / DOCUMENTS
// ============================================================

model Document {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  content     String
  category    String?
  objectKey   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  chunks DocumentChunk[]

  @@index([tenantId])
  @@map("documents")
}

model DocumentChunk {
  id         String                     @id @default(uuid())
  documentId String
  content    String
  embedding  Unsupported("vector(1536)")?
  metadata   Json?
  chunkIndex Int
  createdAt  DateTime                   @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_chunks")
}

// ============================================================
// WEBHOOKS
// ============================================================

model Webhook {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  url       String
  secret    String
  events    Json     // Array of subscribed event strings
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("webhooks")
}

model WebhookDelivery {
  id          String   @id @default(uuid())
  webhookId   String
  event       String
  payload     Json
  attempt     Int      @default(1)
  maxAttempts Int      @default(5)
  httpStatus  Int?
  response    String?
  success     Boolean  @default(false)
  nextRetryAt DateTime?
  createdAt   DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([success])
  @@index([nextRetryAt])
  @@map("webhook_deliveries")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id            String   @id @default(uuid())
  userId        String
  tenantId      String
  title         String
  message       String
  type          String   // NotificationType enum value
  channel       String   // NotificationChannel enum value
  referenceType String?
  referenceId   String?
  isRead        Boolean  @default(false)
  readAt        DateTime?
  createdAt     DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([userId, isRead])
  @@index([tenantId])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  tenantId     String
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user   User?  @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, action])
  @@index([tenantId, resourceType])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
