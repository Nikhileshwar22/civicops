# ============================================================
# CivicOps - Environment Configuration
# Copy this file to .env and update the values
# ============================================================

# ---- Application ----
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
API_PREFIX=api/v1

# ---- Database ----
DATABASE_URL=postgresql://civicops:civicops_dev_password@localhost:5432/civicops?schema=public

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=civicops:

# ---- JWT ----
JWT_ACCESS_SECRET=your-access-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Cloudflare R2 Storage ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=civicops
R2_ENDPOINT=
CDN_URL=https://cdn.civicops.com
MAX_FILE_SIZE=10485760

# ---- AI Configuration ----
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro
GEMINI_VISION_MODEL=gemini-pro-vision
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_VISION_MODEL=gpt-4-vision-preview
EMBEDDING_MODEL=text-embedding-004
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.3

# ---- Email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@civicops.com

# ---- Sentry (Error Monitoring) ----
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_CDN_URL=https://cdn.civicops.com
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
